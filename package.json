{
  "name": "real-estate-workspace-foundation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "test:foundation": "npm run typecheck && npm run test:rls && npm run test:inventory-rls && npm run test:booking-concurrency && npm run test:installments-math && npm run test:contracts-transaction && npm run test:payments-concurrency && npm run build",
    "test:inventory-rls": "node scripts/test-inventory-rls.mjs",
    "test:booking-concurrency": "node --import tsx scripts/test-booking-concurrency.mjs",
    "test:installments-math": "node --import tsx scripts/test-installments-math.mjs",
    "test:contracts-transaction": "node --import tsx scripts/test-contracts-transaction.mjs",
    "test:payments-concurrency": "node --import tsx scripts/test-payments-concurrency.mjs",
    "db:seed-demo": "node --env-file-if-exists=.env.local --import tsx scripts/seed-demo.mjs",
    "test:e2e": "playwright test",
    "db:create-demo-runtime": "node --env-file-if-exists=.env.local scripts/create-demo-runtime.mjs",
    "auth:create-admin": "node --env-file-if-exists=.env.local --import tsx scripts/create-admin.ts",
    "auth:create-runtime": "node --env-file-if-exists=.env.local --import tsx scripts/create-auth-runtime.ts",
    "test:auth-rls": "node scripts/test-auth-rls.mjs",
    "auth:create-platform-owner": "node --env-file-if-exists=.env.local --import tsx scripts/create-platform-owner.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "docxtemplater": "^3.67.0",
    "drizzle-orm": "0.45.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.1",
    "next-auth": "5.0.0-beta.32",
    "pizzip": "^3.2.0",
    "postgres": "^3.4.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.3.1",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
