# Never commit credentials. Keep DB admin URL ONLY in migrations/CI secrets.
DATABASE_URL_ADMIN=postgresql://MIGRATION_OWNER:PASSWORD@HOST/DATABASE?sslmode=require
# A SEPARATE login with only tenant_runtime privileges.
DATABASE_URL=postgresql://FOUNDATION_RUNTIME:PASSWORD@HOST/DATABASE?sslmode=require
# Used only in the disposable RLS isolation test; never production.
TEST_DATABASE_URL_ADMIN=

# Booking API: trusted external identity provider (server-side only).
BOOKING_AUTH_JWKS_URL=https://your-identity-provider.example/.well-known/jwks.json
BOOKING_AUTH_ISSUER=https://your-identity-provider.example/
BOOKING_AUTH_AUDIENCE=real-estate-workspace
