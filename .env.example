# Run migrations/admin creation from a trusted CLI ONLY; do not set ADMIN URL in the web service.
DATABASE_URL_ADMIN=postgresql://MIGRATION_OWNER:YOUR_SECRET@127.0.0.1:5432/workspace_demo
# Business login: member of tenant_runtime, NOBYPASSRLS.
DATABASE_URL=postgresql://workspace_demo_runtime:YOUR_SECRET@127.0.0.1:5432/workspace_demo
# Separate identity-only login: member of auth_runtime, not tenant_runtime or an owner.
AUTH_DATABASE_URL=postgresql://workspace_auth_runtime:YOUR_AUTH_PASSWORD@127.0.0.1:5432/workspace_demo
AUTH_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-32-characters
AUTH_URL=http://127.0.0.1:3000
# Set AUTH_TRUST_HOST=true only behind a trusted proxy that sanitizes Host headers.
AUTH_RUNTIME_PASSWORD=replace-with-a-random-password-of-at-least-24-characters
ADMIN_TENANT_ID=
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
TEST_DATABASE_URL_ADMIN=
# Optional disposable demo fixtures only. No mock authentication exists.
DEMO_SEED_ALLOW=I_ACKNOWLEDGE_DEMO_ONLY
DEMO_RUNTIME_PASSWORD=replace-with-a-random-password-of-at-least-24-characters
DEMO_ACCOUNT_PASSWORD=replace-with-a-test-only-password-of-at-least-12-characters
