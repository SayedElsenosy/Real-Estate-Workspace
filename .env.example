# Secrets must NEVER be committed. Use a dedicated demo database called workspace_demo.
DATABASE_URL_ADMIN=postgresql://MIGRATION_OWNER:YOUR_SECRET@127.0.0.1:5432/workspace_demo
DATABASE_URL=postgresql://workspace_demo_runtime:YOUR_DEMO_RUNTIME_PASSWORD@127.0.0.1:5432/workspace_demo
TEST_DATABASE_URL_ADMIN=

# LOCAL DEV ONLY: disabled by code in NODE_ENV=production.
ENABLE_LOCAL_MOCK_LOGIN=true
DEMO_SEED_ALLOW=I_ACKNOWLEDGE_DEMO_ONLY
DEMO_RUNTIME_PASSWORD=replace-with-a-random-password-of-at-least-24-characters
MOCK_AUTH_SECRET=replace-with-a-cryptographically-random-32-character-minimum-secret

# Production: provide real identity-provider settings and restricted DATABASE_URL.
BOOKING_AUTH_JWKS_URL=https://identity.example/.well-known/jwks.json
BOOKING_AUTH_ISSUER=https://identity.example/
BOOKING_AUTH_AUDIENCE=real-estate-workspace
